# Copy to .env at the repository root. Never commit .env.
# This phase supports local, single-user development only.
RF_APP_ENV=development
RF_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# PostgreSQL is required to save sessions in Phase 1. Use a local-only password.
# Bootstrap appends RF_DATABASE_URL using these values; keep both in sync if changed.
POSTGRES_USER=researchforge
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=researchforge
# RF_DATABASE_URL=postgresql+psycopg://USER:URL_ENCODED_PASSWORD@127.0.0.1:5432/researchforge

# Phase 2: disabled by default. Set BOTH to mock for free offline demonstrations.
RF_LLM_PROVIDER=disabled
RF_SEARCH_PROVIDER=disabled
# Hosted configuration is optional and has NOT been live-verified. Never enable costs
# before explicit user approval. A ChatGPT subscription does not include API credits.
RF_LIVE_CALLS_APPROVED=false
# RF_LLM_MODEL=gpt-4.1-mini
# RF_OPENAI_API_KEY=
# RF_BRAVE_API_KEY=
# Phase 7 local inference (no API key or paid service). Use the already-cached tag only:
# RF_LLM_PROVIDER=ollama
# RF_OLLAMA_URL=http://127.0.0.1:11434
# RF_OLLAMA_MODEL=qwen3:8b
# RF_OLLAMA_CONTEXT_TOKENS=8192
# RF_OLLAMA_TIMEOUT_SECONDS=90
# Optional no-key search, limited to English Wikipedia (not the whole public web).
# Requires an operator-supplied real contact URL/email in the User-Agent. Do not copy
# a sample identity; observe Wikimedia usage/User-Agent policies and CC BY-SA attribution.
# Document-only local research can keep RF_SEARCH_PROVIDER=disabled.
# RF_SEARCH_PROVIDER=wikipedia
RF_FREE_SEARCH_ENABLED=false
# Set RF_PUBLIC_SEARCH_CONTACT only to the operator's own real HTTPS page or mailto address.
# RF_PUBLIC_SEARCH_CONTACT=
RF_LLM_TEMPERATURE=0.2
RF_LLM_MAX_OUTPUT_TOKENS=1500
RF_PROVIDER_TIMEOUT_SECONDS=15
RF_PROVIDER_RETRIES=1
RF_MAX_EXTERNAL_RETRIES=0
RF_RUN_TIMEOUT_SECONDS=120
RF_MAX_SEARCH_QUERIES=5
RF_MAX_SOURCES=5
RF_MAX_TOOL_CALLS=18
RF_MAX_CONTEXT_CHARS=16000
RF_MAX_PAGE_BYTES=512000
RF_MAX_ARTICLE_TEXT_CHARS=20000
RF_MAX_EXTERNAL_REQUESTS_PER_RUN=3
RF_MAX_EXTERNAL_SEARCH_REQUESTS=1
RF_MAX_ARTICLE_FETCH_ATTEMPTS=2
# Optional process-wide acceptance cap; set to 6 for a two-run acceptance window.
# RF_MAX_GLOBAL_EXTERNAL_REQUESTS=6
# Phase 4: bounded claim assessment and adaptive follow-up (no confidence calibration).
RF_MAX_VERIFICATION_ITERATIONS=1
RF_MAX_FOLLOWUP_SEARCHES=1
RF_MAX_LLM_CALLS=16
RF_MAX_TOTAL_TOKENS=24000
RF_MAX_ESTIMATED_COST_USD=0.25
# Optional CURRENT approved LLM prices per million tokens; no default price assumed.
# RF_INPUT_USD_PER_MILLION=
# RF_OUTPUT_USD_PER_MILLION=
# RF_SEARCH_USD_PER_REQUEST=
# Live settings require all three unit prices, copied from provider pricing confirmed
# by the operator. They are estimates, not provider-enforced billing caps.

# Phase 3: pinned small English embedding model, cached only; run explicit download script.
RF_EMBEDDING_PROVIDER=local
RF_EMBEDDING_BATCH_SIZE=8
RF_QDRANT_URL=http://127.0.0.1:6333
RF_QDRANT_NAMESPACE=researchforge
RF_MAX_UPLOAD_BYTES=5000000
RF_MAX_DOCUMENTS=30
RF_CHUNK_CHARS=1000
RF_CHUNK_OVERLAP=150
RF_RETRIEVAL_K=5
